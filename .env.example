# Vorlage für .env.local. `npm run setup` füllt die Geheimnisse automatisch aus.
# Hier nie echte Werte eintragen: Diese Datei ist öffentlich.

# ─── Pflicht ───────────────────────────────────
# Aus Supabase, siehe SETUP.md Schritt 2.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Login. Der PIN hat so viele Stellen wie NEXT_PUBLIC_PIN_LENGTH (4 bis 8).
DASHBOARD_PIN=
NEXT_PUBLIC_PIN_LENGTH=6
SESSION_SECRET=
# Verschlüsselt gespeicherte Zugangsdaten, z. B. für den iCloud-Kalender.
CREDENTIALS_KEY=
# Vercel schickt diesen Wert an die täglichen Cron-Jobs.
CRON_SECRET=

# ─── Push-Nachrichten ──────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Eine Kontaktadresse, z. B. mailto:du@example.com
VAPID_SUBJECT=

# ─── Optional: WHOOP ───────────────────────────
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# https://DEINE-DOMAIN/api/whoop/callback
WHOOP_REDIRECT_URI=
WHOOP_WEBHOOK_SECRET=

# ─── Optional: Apple Health (iOS-Kurzbefehl) ───
HEALTH_SYNC_TOKEN=

# ─── Optional: Notion ──────────────────────────
NOTION_TOKEN=
NOTION_REFLECT_DB_ID=
NOTION_ABO_DB_ID=
# Abo-Erinnerungen: Vorlauf in Tagen und Mindestbetrag in Euro.
SUBS_LEAD_DAYS=
SUBS_MIN_AMOUNT_EUR=

# ─── Optional: Finanzen ────────────────────────
# Google Gemini für die KI-Einblicke.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Hebt das CoinGecko-Limit an bzw. aktiviert Edelmetallpreise.
COINGECKO_API_KEY=
METALS_DEV_API_KEY=
# Nur für eine Anbindung an ein zweites Dashboard.
BUSINESS_BRIDGE_TOKEN=

# ─── Optional: KI-Zugriff (AGENT_API.md, MCP_SERVER.md) ───
AGENT_API_TOKEN=
AGENT_API_READ_TOKEN=
# Ein zweiter Vollzugang für einen weiteren Agenten, mindestens 32 Zeichen.
AGENT_API_GROK_TOKEN=
# 1 erlaubt Agenten das Schreiben. Leer heißt: nur lesen.
AGENT_API_WRITE_ENABLED=
MCP_OAUTH_SECRET=
# Weitere erlaubte OAuth-Callback-Hosts (Kommaliste).
MCP_OAUTH_REDIRECT_HOSTS=
# Öffentliche Adresse, falls sie nicht automatisch erkannt wird.
MCP_PUBLIC_ORIGIN=

# ─── Optional: Telegram-Push über n8n ──────────
NOTIFY_WEBHOOK_SECRET=
